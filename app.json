{
	"expo": {
		"name": "BrainClean",
		"slug": "brainclean",
		"version": "0.9.9",
		"orientation": "portrait",
		"icon": "./assets/images/logo_in_white_color.png",
		"scheme": "brainclean",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.brainclean.app",
			"permissions": [],
			"blockedPermissions": [
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.WRITE_EXTERNAL_STORAGE",
				"com.google.android.gms.permission.AD_ID"
			]
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/logo_in_white_color.png",
					"imageWidth": 180,
					"resizeMode": "contain",
					"backgroundColor": "#2563EB",
					"dark": {
						"backgroundColor": "#2563EB"
					}
				}
			],
			"expo-secure-store",
			"./plugins/withProductionAndroidConfig"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "74f9a88a-13ea-4bd8-b0f6-fac07d4c97bb"
			}
		},
		"owner": "rehan21"
	}
}
